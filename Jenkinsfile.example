// Public-safe Jenkins pipeline example.
//
// Keep the real Jenkins Pipeline Script inside Jenkins when it contains SSH,
// private repository URLs, internal hostnames/IPs, registry URLs, or credentials.
// This example documents a Compose-first flow that does not require npm/node on
// the Jenkins agent. The Dockerfile builds the Svelte/Vite apps inside node:alpine.
pipeline {
    agent any

    environment {
        IMAGE_NAME = '26fa-ui'
        CONTAINER_NAME = '26fa-ui'
        APP_PORT = '8080'
        IMAGE_TAG = "${BUILD_NUMBER}"
        FULL_IMAGE = "${IMAGE_NAME}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build image with Compose') {
            steps {
                sh '''
                    set -eux
                    FULL_IMAGE="${FULL_IMAGE}" \
                    IMAGE_TAG="${IMAGE_TAG}" \
                    CONTAINER_NAME="${CONTAINER_NAME}" \
                    APP_PORT="${APP_PORT}" \
                    docker compose build
                '''
            }
        }

        stage('Deploy with Compose') {
            steps {
                sh '''
                    set -eux
                    FULL_IMAGE="${FULL_IMAGE}" \
                    IMAGE_TAG="${IMAGE_TAG}" \
                    CONTAINER_NAME="${CONTAINER_NAME}" \
                    APP_PORT="${APP_PORT}" \
                    docker compose up -d
                '''
            }
        }

        stage('Smoke test') {
            steps {
                sh '''
                    set -eux
                    curl -fsS "http://localhost:${APP_PORT}/healthz"
                    curl -fsS "http://localhost:${APP_PORT}/project1/" | grep -i '<div id="app">'
                    curl -fsS "http://localhost:${APP_PORT}/hw2/" | grep -i '<div id="app">'
                '''
            }
        }
    }
}
